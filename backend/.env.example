# Server-side only. Never use a VITE_ prefix for the key.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local demo limits. Run a single backend worker.
HOST=127.0.0.1
PORT=8000
SESSION_TTL_SECONDS=1800
CLEANUP_INTERVAL_SECONDS=30
MAX_SESSIONS=32
HISTORY_LIMIT=8
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=16000000
MAX_INFLIGHT_REQUESTS=8

# Optional: trusted teammate module, relative to backend/. Leave blank for baseline coaching.
# Export buildTutoringInstructions({ action, hintLevel }) returning a string.
TUTORING_PROMPT_MODULE=
